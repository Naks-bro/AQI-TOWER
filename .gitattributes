* text=auto

# Keep engineering source files usable in Ubuntu/WSL and CI.
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.pvsm text eol=lf
cfd/** text eol=lf

# Binary engineering and report assets.
*.FCStd binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.zip binary

# Curated handoff manifests hash exact bytes, including CSV line endings.
reports/prototype_d01/internal_handoff_20261005/** -text -diff
*.blend binary
# Preserve generated delivery bytes so packaged manifests survive cloning.
reports/shareable_20261005/** -text -diff
