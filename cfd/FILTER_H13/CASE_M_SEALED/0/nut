FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    AIR_INLET
    {
        type            calculated;
        value           uniform 0;
    }
    AIR_OUTLET
    {
        type            calculated;
        value           uniform 0;
    }
    WALLS
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    FILTER_UPSTREAM
    {
        type            cyclic;
    }
    FILTER_DOWNSTREAM
    {
        type            cyclic;
    }
    FILTER_FRAME_UPSTREAM
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    FILTER_FRAME_DOWNSTREAM
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    BYPASS_SEAL_DIRTY
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    BYPASS_SEAL_CLEAN
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
}


